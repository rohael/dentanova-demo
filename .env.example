# Skopiuj do .env i dostosuj:  cp .env.example .env
# Plik .env jest w .gitignore - nie trafia do repozytorium.

# Na jakim adresie nasłuchuje port aplikacji:
#   127.0.0.1 - tylko ten serwer (domyślnie, gdy całość idzie przez Cloudflare Tunnel)
#   0.0.0.0   - też inne urządzenia w sieci lokalnej, np. http://<IP-serwera>:8095
DENTANOVA_BIND=127.0.0.1

# Port na serwerze (zmień, jeśli 8095 jest zajęty)
DENTANOVA_PORT=8095

